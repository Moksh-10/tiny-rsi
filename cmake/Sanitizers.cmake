set(TINY_RSI_SANITIZER "" CACHE STRING "Sanitizer: address or thread")
if(TINY_RSI_SANITIZER)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
    message(FATAL_ERROR "Sanitizer builds require Clang or GCC")
  endif()
  if(TINY_RSI_SANITIZER STREQUAL "address")
    set(sanitizer_flag "-fsanitize=address,undefined")
  elseif(TINY_RSI_SANITIZER STREQUAL "thread")
    set(sanitizer_flag "-fsanitize=thread")
  else()
    message(FATAL_ERROR "Unsupported TINY_RSI_SANITIZER value")
  endif()
  add_compile_options(${sanitizer_flag} -fno-omit-frame-pointer)
  add_link_options(${sanitizer_flag})
endif()
